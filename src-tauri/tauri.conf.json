{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Breizh Reprog X Ninnin Projet Perf",
  "version": "1.19.0",
  "identifier": "com.breizhreprog.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3001",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "Breizh Reprog X Ninnin Projet Perf",
        "width": 1500,
        "height": 950,
        "minWidth": 680,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "backgroundColor": "#0a0b0f",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --overscroll-history-navigation=0 --pull-to-refresh=0"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Breizh Reprog X Ninnin Projet Perf",
    "copyright": "Copyright © 2026 Breizh Reprog X Ninnin",
    "homepage": "https://github.com/tremaudanlenny-arch/breizhreprog",
    "shortDescription": "Breizh Reprog X Ninnin Projet Perf - ECU map editor 1.19",
    "longDescription": "Breizh Reprog X Ninnin Projet Perf - ECU map editor for Bosch EDC15/EDC16.",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "languages": [
          "English",
          "French",
          "Spanish",
          "Italian",
          "German",
          "Portuguese",
          "Romanian"
        ],
        "customLanguageFiles": {
          "Romanian": "./nsis/Romanian.nsh"
        },
        "displayLanguageSelector": true
      }
    }
  }
}
