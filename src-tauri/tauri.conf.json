{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Breizh Reprog",
  "version": "1.2.5",
  "identifier": "com.breizhreprog.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "Breizh Reprog",
        "width": 1500,
        "height": 950,
        "minWidth": 680,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "backgroundColor": "#0a0b0f",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --overscroll-history-navigation=0 --pull-to-refresh=0"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Breizh Reprog",
    "copyright": "Copyright © 2026 Breizh Reprog",
    "homepage": "https://github.com/tremaudanlenny-arch/breizhreprog",
    "shortDescription": "ECU map editor for VAG-group Bosch EDC15/EDC16",
    "longDescription": "Breizh Reprog is a local ECU map editor for VAG-group Bosch EDC15/EDC16 ECUs with map detection, table/2D/3D editing, hexdump, virtual dyno, DTC tools, checksum correction and WinOLS-compatible mappack export.",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp",
        "languages": ["English", "French", "Spanish", "Italian", "German", "Portuguese", "Romanian"],
        "customLanguageFiles": {
          "Romanian": "./nsis/Romanian.nsh"
        },
        "displayLanguageSelector": true
      }
    }
  }
}